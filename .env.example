# =============================================================================
# Cloudflare OS — environment template
# =============================================================================
# Copy what you need into a real secret store; never commit filled values.
#
# Local dev:    copy relevant lines to `.dev.vars` (gitignored).
#               `pnpm dev-server` / `pnpm run-local` load root `.dev.vars`.
# Production:   set as Worker vars/secrets (dashboard, wrangler secret, or
#               deploy service). This file documents names + meaning only.
#
# AnyRouter as a model provider does NOT need a Worker env key. Users connect
# via the Add Model dialog (device login or paste sk-ar-…). Optional smoke
# tools below are the only place ANYROUTER_* appears.
# =============================================================================

# -----------------------------------------------------------------------------
# Deploy tooling (local wrangler / CI only — not Worker runtime)
# -----------------------------------------------------------------------------
# Account that owns the `cowork` / `cowork-backend` Workers (or your names).
CLOUDFLARE_ACCOUNT_ID=
# API token with Workers Scripts Edit, Workers KV, R2, Account Settings Read
# (and AI Gateway if you configure gateway vars). Used by `wrangler deploy`.
CLOUDFLARE_API_TOKEN=

# Worker script names for this fork’s production layout.
# Deploy configs: packages/router/wrangler.anyrouter-os.jsonc
#                 packages/workshop-backend/wrangler.anyrouter-os.jsonc
#   pnpm exec wrangler deploy --config wrangler.anyrouter-os.jsonc
# Router worker:  anyrouter-os          (custom domain os.anyrouter.dev)
# Backend worker: anyrouter-os-backend
# ANYROUTER_OS_ROUTER_WORKER=anyrouter-os
# ANYROUTER_OS_BACKEND_WORKER=anyrouter-os-backend

# -----------------------------------------------------------------------------
# Core deployment (workshop-backend Worker vars)
# -----------------------------------------------------------------------------
# Public origin users open in the browser (no trailing slash).
PUBLIC_BASE_URL=https://os.anyrouter.dev

# Deployment admins (verified email or username, depending on auth mode).
# In wrangler/dashboard this is often a JSON array; in `.dev.vars` use a
# comma-separated list only if your tooling expands it — production usually:
#   ADMINS=["you@example.com"]
# ADMINS=

# Link shown for “reconfigure this instance” (hosted deploy wizard), optional.
# DEPLOY_URL=https://os.cloudflare.app/deploy/?instance=...

# -----------------------------------------------------------------------------
# Sign-in: Cloudflare Access (SSO in front of the Worker)
# -----------------------------------------------------------------------------
# When CF_ACCESS_AUD is set, identity comes from Access JWT (Access-mode frontend:
# build with VITE_CF_ACCESS_MODE=true).
# CF_ACCESS_AUD=                  # Access application audience (AUD) tag
# CF_ACCESS_ISS=https://<team>.cloudflareaccess.com

# -----------------------------------------------------------------------------
# Sign-in: Clerk (used by the os.anyrouter.dev deploy)
# -----------------------------------------------------------------------------
# Setting CLERK_PUBLISHABLE_KEY makes Clerk the ONLY way in (password auth off).
# It is public and already committed in
# packages/workshop-backend/wrangler.anyrouter-os.jsonc as
#   pk_live_Y2xlcmsuYW55cm91dGVyLmRldiQ   -> clerk.anyrouter.dev
# The backend derives the issuer/JWKS from this key; there is no CLERK_ISSUER var.
# CLERK_PUBLISHABLE_KEY=pk_live_...
#
# Clerk Backend API key — resolves the signed-in user's email, since the default
# session token carries no email claim. Never commit; deploy it as a secret:
#   printf '%s' "$CLERK_SECRET_KEY" | pnpm exec wrangler secret put CLERK_SECRET_KEY \
#     --config wrangler.anyrouter-os.jsonc
# Not needed if the Clerk instance's session token adds an "email" claim.
# CLERK_SECRET_KEY=sk_live_...

# -----------------------------------------------------------------------------
# Sign-in: password + optional OAuth gatekeepers (see docs/public-server.md)
# -----------------------------------------------------------------------------
# Comma-separated gatekeeper vendor ids allowed for “Continue with …”.
# AUTH_GATEKEEPERS=google,github,cloudflare
# DISABLE_PASSWORD_AUTH=true      # only if AUTH_GATEKEEPERS is non-empty

# OAuth apps for gatekeepers (dev: root `.dev.vars`; prod: each gatekeeper Worker).
# Redirect URIs use PUBLIC_BASE_URL, e.g. ${PUBLIC_BASE_URL}/gatekeeper/github/oauth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CLOUDFLARE_OAUTH_CLIENT_ID=
# CLOUDFLARE_OAUTH_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# SUPABASE_CLIENT_ID=
# SUPABASE_CLIENT_SECRET=
# CONFLUENCE_CLIENT_ID=
# CONFLUENCE_CLIENT_SECRET=
# ZOOMINFO_CLIENT_ID=
# ZOOMINFO_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Platform AI Gateway (optional free-tier / server-managed provider keys)
# -----------------------------------------------------------------------------
# When CF_AI_GATEWAY is set, listed providers route through Cloudflare AI Gateway
# and do not use per-user provider tokens. ACCOUNT_ID + API_TOKEN are required.
# AnyRouter / Ollama are direct-only and never use this path.
#
# CF_AI_GATEWAY=cowork-ai           # gateway name (independent of worker names)
# CF_AI_GATEWAY_PROVIDERS=cloudflare
# CF_AI_GATEWAY_ACCOUNT_ID=
# CF_AI_GATEWAY_API_TOKEN=          # AI Gateway Run + Read (secret; wrangler secret put)
# CF_AI_GATEWAY_WAI=                # optional separate gateway for Workers AI
# CF_AI_GATEWAY_WAI_DIRECT=true     # Workers AI via REST, no gateway / cost logs

# Free-tier limits + Cloudflare BYOK top-up (docs/ai-gateway-billing.md)
# ENABLE_CLOUDFLARE_LIMITS=true
# DAILY_LLM_CALL_LIMIT=100
# MINIMUM_CLOUDFLARE_BALANCE=5

# -----------------------------------------------------------------------------
# Frontend build (Vite — set at build time, not on the Worker)
# -----------------------------------------------------------------------------
# Required for deployments behind Cloudflare Access:
# VITE_CF_ACCESS_MODE=true
# Optional: force backend host when assets are not same-origin
# VITE_BACKEND_HOST=
# Opt-in browser error reporting (also needs Worker bindings)
# VITE_FRONTEND_ERROR_REPORTING=true
# Local auto-login (dev only — never in production builds)
# VITE_DEV_AUTO_LOGIN=true
# VITE_DEV_USERNAME=dev
# VITE_DEV_PASSWORD=devpassword

# -----------------------------------------------------------------------------
# AnyRouter (model provider — no Worker env required)
# -----------------------------------------------------------------------------
# Production: users add models in UI (Connect with AnyRouter device login, or
# paste sk-ar-…). Default base URL is https://anyrouter.dev/api/v1.
#
# Optional smoke script only (packages/workshop-backend):
#   pnpm --filter workshop-backend smoke:anyrouter
# ANYROUTER_API_KEY=sk-ar-...
# ANYROUTER_MODEL=z-ai/glm-5.2
# ANYROUTER_BASE_URL=https://anyrouter.dev/api/v1

# -----------------------------------------------------------------------------
# Optional MCP / portal gatekeepers (dev passthrough from .dev.vars)
# -----------------------------------------------------------------------------
# MCP_PORTAL_URL=
# MCP_PORTAL_NAME=
# MCP_PORTAL_AUTH=
# MCP_PORTAL_TOKEN=
# MCP_PORTAL_TRUST_ANNOTATIONS=
# MCP_ALLOW_INSECURE=false

# -----------------------------------------------------------------------------
# Resources (not env vars — provision via wrangler / dashboard)
# -----------------------------------------------------------------------------
# Workshop backend needs: KV BLUEPRINTS, KV AVATARS, R2 BLUEPRINT_CONTENT,
# optional BROWSER (Browser Rendering), optional WORKERS_AI, Worker Loader.
# Router binds WORKSHOP_BACKEND → backend script and serves frontend assets.
# Custom domain: attach hostname to the router Worker (os.anyrouter.dev).
# Cloudflare Access: add os.anyrouter.dev to the Access app whose AUD matches
# CF_ACCESS_AUD (same app as the previous host is fine; keep AUD unchanged).
