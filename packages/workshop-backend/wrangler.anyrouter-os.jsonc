{
  "name": "anyrouter-os-backend",
  "account_id": "7df185a18b98382c3240fa7ac4a37075",
  "main": ".wrangler/validate/src/server.ts",
  "build": {
    "command": "pnpm run build:format-blueprints && pnpm run build:worker",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": [
    "allow_irrevocable_stub_storage",
    "enhanced_error_serialization",
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "browser": { "binding": "BROWSER" },
  "migrations": [
    { "tag": "v0", "new_sqlite_classes": ["UserDurableObject", "OverseerDurableObject"] },
    { "tag": "v1", "new_sqlite_classes": ["AdminSettings"] },
    { "tag": "v2", "new_sqlite_classes": ["PendingLogin"] }
  ],
  "kv_namespaces": [
    { "binding": "BLUEPRINTS", "id": "e0198c767f464f9d924aed0990b004a0" },
    { "binding": "AVATARS", "id": "f47b716d46ec433db94dbc9c0db2321f" }
  ],
  "r2_buckets": [
    { "binding": "BLUEPRINT_CONTENT", "bucket_name": "cowork-blueprint-content" }
  ],
  "worker_loaders": [{ "binding": "LOADER" }],
  "ai": { "binding": "WORKERS_AI" },
  "services": [
    {
      "binding": "GATEKEEPER_GITHUB",
      "service": "anyrouter-os-gatekeeper-github",
      "entrypoint": "GatekeeperVendor"
    },
    {
      "binding": "GATEKEEPER_MCP",
      "service": "anyrouter-os-gatekeeper-mcp",
      "entrypoint": "GatekeeperVendor"
    }
  ],
  "vars": {
    "ADMINS": ["duyet.cs@gmail.com"],
    // Clerk sign-in (same instance as anyrouter.dev) is the only way in. The publishable key is
    // public; CLERK_SECRET_KEY (email lookup) is a wrangler secret.
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuYW55cm91dGVyLmRldiQ",
    // "Sign in with AnyRouter" first-party OAuth client, defined in AnyRouter's own schema
    // (anyrouter repo, db/migrations/0183) — not a runtime DCR registration.
    "ANYROUTER_OAUTH_CLIENT_ID": "anyrouter-os",
    "DEPLOY_URL": "https://os.cloudflare.app/deploy/?instance=d638574e-856d-47b8-a671-65cd9c463840",
    "PUBLIC_BASE_URL": "https://os.anyrouter.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "workers_dev": true
}
