{
  "name": "anyrouter-os-gatekeeper-mcp",
  "account_id": "7df185a18b98382c3240fa7ac4a37075",
  "main": ".wrangler/validate/src/mcp.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": [
    "allow_irrevocable_stub_storage",
    "global_fetch_strictly_public"
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["McpAccount", "McpGatekeeperImpl"]
    }
  ],
  "vars": {
    "BASE_URL": "https://os.anyrouter.dev/gatekeeper/mcp",
    "MCP_CLIENT_NAME": "AnyRouter OS",
    "MCP_ALLOW_INSECURE": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "workers_dev": true
}
