{
  "name": "anyrouter-os",
  "account_id": "23050adb6c92e313643a29e1ba64c88a",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-02",
  "workers_dev": true,
  "preview_urls": false,
  "services": [
    { "binding": "WORKSHOP_BACKEND", "service": "anyrouter-os-backend" },
    { "binding": "GATEKEEPER_GITHUB", "service": "anyrouter-os-gatekeeper-github" },
    { "binding": "GATEKEEPER_MCP", "service": "anyrouter-os-gatekeeper-mcp" }
  ],
  "routes": [
    { "pattern": "os.anyrouter.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "../workshop-frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/blueprint-screenshot",
      "/blueprint-screenshot/*",
      "/gatekeeper/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
