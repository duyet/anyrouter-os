{
  "name": "anyrouter-os-gatekeeper-github",
  "account_id": "23050adb6c92e313643a29e1ba64c88a",
  "main": ".wrangler/validate/src/github.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_als"],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["UserAccount", "GitHubGatekeeperImpl"]
    }
  ],
  "vars": {
    "BASE_URL": "https://os.anyrouter.dev/gatekeeper/github"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "workers_dev": true
}
